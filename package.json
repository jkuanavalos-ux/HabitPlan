{
  "name": "habitplan",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "check:db": "node scripts/check-db.cjs",
    "export:android": "expo export --platform android",
    "db:generate": "drizzle-kit generate && node scripts/bundle-migrations.cjs"
  },
  "dependencies": {
    "@react-navigation/native": "^7.1.33",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.44.7",
    "expo": "~55.0.31",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.40",
    "expo-haptics": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "drizzle-kit": "^0.31.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.npm-cache/"
    ]
  }
}
